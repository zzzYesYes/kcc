# Shared Kubernetes context and external S3 credentials.
KUBE_CONTEXT=
S3_ENDPOINT_URL=http://minio-k12.k12-lake.svc.cluster.local:9000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Data Lake release and storage.
HELM_RELEASE=k12-data-lake
DATA_LAKE_NAMESPACE=k12-lake
MINIO_EXISTING_SECRET=minio-k12-root
MINIO_STORAGE_CLASS=local-path
MINIO_STORAGE_SIZE=500Gi
MINIO_API_NODE_PORT=30900
MINIO_CONSOLE_NODE_PORT=31901

# Acquisition runs outside Kubernetes on an authorized collection machine.
K12_ACCESS_TOKEN=
K12_BATCH_ID=
K12_SOURCE_PREFIX=source=tchMaterial-parser/batch_id=replace-me
K12_OUTPUT_ROOT=./k12-ingest
K12_SCOPE=tagged

# Cleaning/QA controller image. NPU worker images are configured in Helm values.
IMAGE_REPOSITORY=data-pipeline
IMAGE_TAG=dev
BASE_IMAGE=python:3.11-slim

# Cleaning/QA scripts use RELEASE/NAMESPACE/PROFILE rather than HELM_RELEASE.
RELEASE=k12-pipeline
NAMESPACE=k12
PROFILE=smoke
S3_SECRET_NAME=k12-pipeline-s3
PIPELINE_WORKING_DIR=/opt/data-pipeline/src
PIPELINE_NO_PROXY=localhost,127.0.0.1,.svc,.svc.cluster.local
