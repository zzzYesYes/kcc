# syntax=docker/dockerfile:1.7
ARG KUBECTL_IMAGE
ARG KUBECTL_SOURCE=/bin/kubectl
ARG BASE_IMAGE
FROM ${KUBECTL_IMAGE} AS kubectl
FROM ${BASE_IMAGE}
ARG KUBECTL_SOURCE=/bin/kubectl
USER root
ARG VERSION=1.0.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="kcc-training-head" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="Apache-2.0"

WORKDIR /opt/kcc
COPY --from=kubectl ${KUBECTL_SOURCE} /usr/local/bin/kubectl
COPY pyproject.toml ./
COPY src ./src
COPY ray_startup_bundle/hccl_runtime/hccl_check /opt/kcc-hccl/hccl_check
RUN python -m pip install --no-cache-dir --no-deps --no-build-isolation . \
    && chmod 0755 /usr/local/bin/kubectl

ENV PYTHONPATH=/opt/kcc-hccl \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HCCL_CHECK_PROBE=/opt/kcc-hccl/bin/ranktable_allreduce_probe

