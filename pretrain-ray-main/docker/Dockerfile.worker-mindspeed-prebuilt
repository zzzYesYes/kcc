# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
ARG VERSION=1.0.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="kcc-training-worker-mindspeed" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY site-packages /opt/kcc/mindspeed-python

ENV PYTHONPATH="/opt/kcc/mindspeed-python:${PYTHONPATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
