# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE} AS builder
USER root

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}
WORKDIR /build
COPY pyproject.toml LICENSE ./
COPY src ./src
RUN python -m pip wheel \
      --no-deps \
      --no-cache-dir \
      --no-build-isolation \
      --wheel-dir /opt/wheels \
      .

FROM ${BASE_IMAGE}
USER root
ARG VERSION=1.0.0
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="kcc-training-controller" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY --from=builder /opt/wheels /opt/wheels
RUN python -m pip install \
      --no-cache-dir \
      --no-index \
      --no-deps \
      --force-reinstall \
      --find-links=/opt/wheels \
      "kcc-training==${VERSION}" \
    && python -m compileall -q /usr/local/lib/python*/site-packages/kcc_training \
    && rm -rf /opt/wheels

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HEALTH_PORT=8080
USER 65532:65532
ENTRYPOINT ["python", "-m", "kcc_training.controller_stable"]
