# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
USER root
ARG VERSION=1.0.0
ARG VCS_REF=unknown
ARG RUNTIME_BIN=/usr/local/bin
LABEL org.opencontainers.image.title="kcc-training-worker" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.licenses="Apache-2.0"

COPY site-packages /opt/kcc/python
COPY kcc-hccl /opt/kcc-hccl

ENV PATH="${RUNTIME_BIN}:${PATH}" \
    PYTHONPATH="/opt/kcc/python:/opt/kcc-hccl:${PYTHONPATH}" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HCCL_CHECK_PROBE=/opt/kcc-hccl/bin/ranktable_allreduce_probe
